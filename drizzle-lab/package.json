{
  "name": "drizzle-lab",
  "version": "1.0.0",
  "description": "Laboratorio de Drizzle ORM con PostgreSQL",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "seed": "tsx --env-file=.env src/seed.ts",
    "consultas": "tsx --env-file=.env src/consultas.ts",
    "tx": "tsx --env-file=.env src/transacciones.ts",
    "errores": "tsx --env-file=.env src/errores.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --env-file=.env.test --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:coverage": "c8 npm test",
    "sonar": "npm run test:coverage && node --env-file=../.env.sonar ./node_modules/@sonar/scan/bin/sonar-scanner.js",
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "migrate:prod": "node --env-file=.env dist/migrate.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sonar/scan": "^5.1.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
