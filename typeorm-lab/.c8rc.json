{
  "all": true,
  "src": [
    "src"
  ],
  "extension": [
    ".ts"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/generated/**",
    "test/**",
    "src/index.ts",
    "src/seed.ts",
    "src/consultas.ts",
    "src/transacciones.ts",
    "src/server.ts",
    "src/entities/**"
  ],
  "reporter": [
    "lcov",
    "text-summary"
  ],
  "report-dir": "coverage",
  "check-coverage": true,
  "statements": 100,
  "branches": 100,
  "functions": 100,
  "lines": 100
}
